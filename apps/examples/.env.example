# Copy to `.env` (or `.env.local`) and fill in. Everything is optional: the page asks the
# server for its read-only demo key (GET /vola/examples/config) and a visitor may paste a
# key of their own in Settings.

# Pre-fills the visitor's own key (development convenience): a key of the demo tenant.
#   pnpm vola create-key --tenant demo --name examples-dev --scopes files:read,files:write,folders:read,folders:write,shares:write,keyrings:write
VITE_VOLA_API_KEY=

# The API base URL the page starts with. Default /vola (through the dev server's proxy).
VITE_VOLA_BASE_URL=

# Where the dev server proxies /vola (HTTP and WebSocket). Default http://localhost:8300.
VOLA_SERVER=http://localhost:8300
