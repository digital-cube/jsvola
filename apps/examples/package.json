{
  "name": "@vola/examples",
  "version": "1.0.0",
  "private": true,
  "description": "JSVola examples site: one page per capability (browse, upload, thumbnails, Range & streaming, share, encrypted files, API) over a demo instance, with a read-only visitor key; served by @vola/server at / and /en/ (VOLA_UI_DIR).",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:cov": "vitest run --coverage"
  },
  "dependencies": {
    "@jsudc/core": "0.2.0",
    "@jsudc/react": "0.2.0",
    "@tanstack/react-query": "5.104.4",
    "@tanstack/react-table": "^8.21.3",
    "@vola/client": "workspace:*",
    "@vola/core": "workspace:*",
    "@vola/react": "workspace:*",
    "lucide-react": "^1.59.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^7.18.4"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
