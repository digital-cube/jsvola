---
import Base from "../layouts/Base.astro";
---

<Base title="Not found: vola" description="This address holds nothing." noindex>
  <div class="missing">
    <p class="status">404 file_not_found</p>
    <h1>Nothing is stored at this address.</h1>
    <p class="lede">The page does not exist or has moved. Everything this site holds starts at one of these.</p>
    <div class="actions">
      <a class="button primary" href="/">Go to the home page</a>
      <a class="button secondary" href="/get-started/">Read the docs</a>
    </div>
  </div>
</Base>

<style>
  .missing {
    margin-inline: auto;
    max-width: var(--page-width);
    padding: clamp(4rem, 14vw, 10rem) var(--page-gutter);
    border-top: 1px solid var(--vola-rule-strong);
  }
  .status {
    margin: 0;
    font-family: var(--vola-font-mono);
    font-size: 0.9375rem;
    color: var(--vola-accent);
  }
  h1 {
    margin: 0.75rem 0 0;
    max-width: 18ch;
    font-size: clamp(2.2rem, 5vw, 3.75rem);
    font-stretch: 112%;
    font-weight: 560;
    line-height: 1.05;
    letter-spacing: -0.02em;
    color: var(--vola-ink);
  }
  .lede {
    margin: 1.25rem 0 0;
    max-width: 48ch;
    font-size: 1.0625rem;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }
</style>
