{
  "name": "ticket-desk",
  "version": "1.0.0",
  "private": true,
  "description": "A small help desk on vola (the files) and memento (who did what, when): the program the vola + memento tutorial is written from.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/server/main.ts",
    "start": "node src/server/main.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "vitest run"
  },
  "dependencies": {
    "@jsudc/core": "^0.2.0",
    "@jsudc/server": "^0.2.1",
    "@vola/client": "file:vendor/vola-client-1.0.0.tgz",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.7",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@types/node": "^24",
    "@types/pg": "^8.23.1",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
