{
  "name": "ticket-desk",
  "version": "1.0.0",
  "private": true,
  "description": "A small help desk on vola (the files) and memento (who did what, when): the program the vola + memento tutorial is written from.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/server/main.ts",
    "start": "node src/server/main.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.web.json",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "vitest run",
    "dev:web": "vite",
    "build": "vite build",
    "test:e2e": "vitest run --config vitest.e2e.config.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fastify/http-proxy": "^11.6.6",
    "@fastify/static": "^10.1.8",
    "@jsudc/core": "^0.2.0",
    "@jsudc/react": "^0.2.1",
    "@jsudc/server": "^0.2.1",
    "@memento/react": "file:vendor/memento-react-1.0.0.tgz",
    "@tanstack/react-query": "^5.105.1",
    "@tanstack/react-table": "^8.21.3",
    "@vol-a/client": "file:vendor/vol-a-client-1.0.1.tgz",
    "@vol-a/react": "file:vendor/vol-a-react-1.0.1.tgz",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.7",
    "lucide-react": "^1.66.0",
    "pg": "^8.23.1",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^7.18.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@types/node": "^24",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
