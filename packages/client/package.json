{
  "name": "@vola/client",
  "version": "1.0.0",
  "description": "JSVola client SDK: a fetch-based client for the @vola/server API (browser and Node).",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/digital-cube/jsvola.git",
    "directory": "packages/client"
  },
  "homepage": "https://github.com/digital-cube/jsvola#readme",
  "bugs": "https://github.com/digital-cube/jsvola/issues",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@vola/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:cov": "vitest run --coverage"
  },
  "dependencies": {
    "@vola/core": "workspace:*"
  },
  "publishConfig": {
    "access": "public"
  }
}
