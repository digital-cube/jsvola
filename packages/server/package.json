{
  "name": "@vola/server",
  "version": "1.0.0",
  "description": "JSVola server: Fastify plugin and standalone server, Drizzle/PostgreSQL storage, Redis, tenant isolation, API key auth, UDC collections.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/digital-cube/jsvola.git",
    "directory": "packages/server"
  },
  "homepage": "https://github.com/digital-cube/jsvola#readme",
  "bugs": "https://github.com/digital-cube/jsvola/issues",
  "engines": {
    "node": ">=24"
  },
  "type": "module",
  "exports": {
    ".": {
      "@vola/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "drizzle",
    "udc"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx watch --conditions=@vola/source src/server.ts",
    "start": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "dev:worker": "tsx watch --conditions=@vola/source src/worker.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --conditions=@vola/source src/migrate-cli.ts",
    "db:migrate:test": "MIGRATE_TARGET=test tsx --conditions=@vola/source src/migrate-cli.ts",
    "test": "vitest run",
    "test:cov": "vitest run --coverage"
  },
  "dependencies": {
    "@fastify/multipart": "^10.1.6",
    "@fastify/websocket": "^11.3.5",
    "@jsudc/core": "0.2.0",
    "@jsudc/server": "0.2.1",
    "@vola/core": "workspace:*",
    "@vola/lookups": "workspace:*",
    "argon2": "^0.45.1",
    "bullmq": "^6.5.3",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.7",
    "file-type": "^22.3.0",
    "ioredis": "^6.0.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "sharp": "^0.35.5",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.18.2",
    "drizzle-kit": "^0.31.11",
    "ws": "^8.22.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
