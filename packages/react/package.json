{
  "name": "@vola/react",
  "version": "1.0.0",
  "description": "JSVola React UI: VolaProvider, a live file browser on @jsudc/react, uploads with resumable progress, thumbnails, the keyring PIN gate with auto-lock, and the share dialog.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/digital-cube/jsvola.git",
    "directory": "packages/react"
  },
  "homepage": "https://github.com/digital-cube/jsvola#readme",
  "bugs": "https://github.com/digital-cube/jsvola/issues",
  "engines": {
    "node": ">=24"
  },
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "@vola/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./src/styles.css"
  },
  "files": [
    "dist",
    "src/styles.css"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:cov": "vitest run --coverage"
  },
  "dependencies": {
    "@vola/client": "workspace:*",
    "@vola/core": "workspace:*"
  },
  "peerDependencies": {
    "@jsudc/core": "^0.2.0",
    "@jsudc/react": "^0.2.0",
    "@tanstack/react-query": "^5.104.4",
    "react": ">=19",
    "react-dom": ">=19"
  },
  "devDependencies": {
    "@jsudc/core": "0.2.0",
    "@jsudc/react": "0.2.0",
    "@tanstack/react-query": "5.104.4",
    "@tanstack/react-table": "^8.21.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^30.1.3",
    "lucide-react": "^1.59.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "vola",
    "jsvola",
    "react",
    "file-browser",
    "upload",
    "resumable",
    "udc"
  ]
}
