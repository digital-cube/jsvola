{
  "name": "@vol-a/cli",
  "version": "1.0.1",
  "description": "JSVola CLI: tenants, API keys, migrations and the lookups vocabulary for @vol-a/server.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/digital-cube/jsvola.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/digital-cube/jsvola#readme",
  "bugs": "https://github.com/digital-cube/jsvola/issues",
  "engines": {
    "node": ">=24"
  },
  "type": "module",
  "bin": {
    "vola": "./dist/main.js"
  },
  "exports": {
    ".": {
      "@vol-a/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "tsx --conditions=@vol-a/source src/main.ts",
    "test": "vitest run",
    "test:cov": "vitest run --coverage"
  },
  "dependencies": {
    "@vol-a/client": "workspace:*",
    "@vol-a/core": "workspace:*",
    "@vol-a/lookups": "workspace:*",
    "@vol-a/server": "workspace:*",
    "commander": "^15.0.0",
    "drizzle-orm": "^0.45.4"
  },
  "devDependencies": {
    "fastify": "^5.12.7"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "vola",
    "jsvola",
    "file-storage",
    "cli"
  ]
}
