{
  "$schema": "https://turborepo.com/schema.json",
  "globalEnv": [
    "VOLA_DATABASE_URL",
    "VOLA_DATABASE_URL_TEST",
    "VOLA_REDIS_URL",
    "VOLA_E2E_URL",
    "VOLA_E2E_LOG_LEVEL"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": [],
      "cache": false
    },
    "test:cov": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"],
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test:e2e": {
      "dependsOn": ["^build"],
      "outputs": [],
      "cache": false
    },
    "@vola/cli#test": {
      "dependsOn": ["^build", "@vola/server#test"],
      "outputs": [],
      "cache": false
    },
    "@vola/cli#test:cov": {
      "dependsOn": ["^build", "@vola/server#test:cov"],
      "outputs": ["coverage/**"],
      "cache": false
    }
  }
}
