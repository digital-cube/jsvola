# --- JSVola environment ------------------------------------------------------
# Copy to `.env` and adjust. Every variable is read by @vola/server (and by @vola/cli,
# which talks to the same database). All of them carry the VOLA_ prefix.

# PostgreSQL connection used by the server, the CLI and `pnpm db:migrate`.
VOLA_DATABASE_URL=postgresql://vola:vola@localhost:5432/vola
# Separate database the test suites run against (`pnpm db:migrate:test`, `pnpm test`).
VOLA_DATABASE_URL_TEST=postgresql://vola:vola@localhost:5432/vola_test

# Redis: background jobs (BullMQ queue `vola-processing`), real-time fan-out, unlock tokens.
# Optional: leave empty and `GET /vola/health/ready` reports no `redis` check, jobs run
# synchronously (see VOLA_WORKER_ENABLED) and file events stay in-process.
VOLA_REDIS_URL=redis://localhost:6379/0

# Background jobs (thumbnails, OCR). `auto` (default): queued for the worker process
# (`pnpm start:worker` / the `vola-worker` container) when VOLA_REDIS_URL is set, done
# synchronously otherwise. `1`: insist on the queue (without Redis: one ERROR line, then
# synchronous). `0`: always synchronous — thumbnails render inline on /thumb (200), OCR does not
# run; the right setting when Redis is there but NO worker process consumes the queue (a queued
# thumbnail would answer 202 + grey placeholder forever).
VOLA_WORKER_ENABLED=auto
# Jobs one worker process runs at once. Default 2.
VOLA_WORKER_CONCURRENCY=2
# Redis key prefix of the queue (`<prefix>:vola-processing:*`); server and worker must agree.
# Default `vola`. Several deployments may share one Redis with different prefixes.
VOLA_QUEUE_PREFIX=vola

# OCR (the worker runs the system `tesseract`; a PDF is rasterised with `pdftoppm` first).
# `auto` (default): the server queues an OCR job for every raster image (not SVG/GIF) or PDF
# that is not encrypted, and the worker runs it when `tesseract --version` succeeds at its
# start — otherwise one WARN line and the jobs are SKIPPED. `1`: the worker refuses to start
# without tesseract. `0`: no OCR job is ever created.
VOLA_OCR_ENABLED=auto
# tesseract's `-l`: codes of the OcrLanguages vocabulary joined with `+` (the image ships eng,
# srp, deu). An unknown code, or one the installed tesseract lacks, stops the process at start.
VOLA_OCR_LANGS=eng+srp+deu
# Pages of a PDF the OCR reads, from the first. Default 20.
VOLA_OCR_MAX_PAGES=20
# Seconds one page (or one image) may take in tesseract (and the rasterisation of a PDF).
# Default 120. A page past it fails the try; 3 tries, then the job is FAILED.
VOLA_OCR_TIMEOUT_S=120

# HTTP listener of the standalone server (`pnpm dev`; the Docker image also uses 8300).
VOLA_HOST=0.0.0.0
VOLA_PORT=8300
# Path prefix all vola routes are mounted under.
VOLA_PREFIX=/vola
# Directory the content-addressable blobs live in (the Docker image sets /data/storage).
# Layout: blobs/aa/bb/cc/<sha256> (plus derived files next to the blob) and tmp/ for uploads
# in flight.
VOLA_STORAGE_PATH=var/storage
# Largest file one upload may carry, in bytes; bigger answers 413 file_too_large.
# Default 512 MiB.
VOLA_MAX_UPLOAD_BYTES=536870912
# Hours an unfinished resumable upload (POST /vola/uploads, tus) is kept before its partial
# bytes and row are swept. Default 24.
VOLA_UPLOAD_TTL_HOURS=24
# Controlled vocabulary (@vola/lookups): lookups.yaml and its translations. Defaults: the files
# at the repository root (the Docker image: /app/config). GET /vola/lookups serves them.
VOLA_LOOKUPS_PATH=lookups.yaml
VOLA_TRANSLATIONS_PATH=i18n/translations.csv
# Record values the vocabulary does not know (a file kind, an encryption mode) as candidates
# for review under VOLA_CANDIDATES_DIR (default var/candidates next to lookups.yaml; the
# image: /data/candidates). `vola lookups candidates` lists them, `vola lookup-promote`
# moves them into lookups.yaml. false: nothing is recorded.
VOLA_RECORD_CANDIDATES=true
VOLA_CANDIDATES_DIR=var/candidates
# The sidebar of the examples site, served as the `menu` UDC collection (POST /vola/udc/list
# {collection: "menu"}). Default: menu.yaml at the repository root; a missing file means no
# `menu` collection.
VOLA_MENU_PATH=menu.yaml
# Statistics snapshots (GET /vola/stats/tenant|instance): minutes a snapshot may age before the
# worker's `refresh-stats` job recomputes it for a tenant with file activity since (the job runs
# every half TTL); without a worker a read past the TTL recomputes instead. Default 60.
VOLA_STATS_TTL_MIN=60
# The origin clients reach this server on, used to build the `url` of a share link
# (`<VOLA_PUBLIC_URL><VOLA_PREFIX>/s/<token>`). Set it behind a reverse proxy; empty: the
# protocol and Host of the request that creates the share.
VOLA_PUBLIC_URL=
# Optional audit trail in memento (docs/AUDIT.md): destructive and security-relevant operations
# (file delete / purge / visibility change, share created / revoked, key created / revoked,
# instances transferred) are pushed as memento events to `<VOLA_MEMENTO_URL>/events` with a
# memento API key that holds the `write` scope. Both or neither; empty: audit off (one INFO line,
# never an error). With VOLA_REDIS_URL the worker pushes (5 tries, backoff) — give it the same two
# variables; without Redis the server pushes once, fire and forget, 2 s timeout. A request never
# waits for memento and never fails because of it.
VOLA_MEMENTO_URL=
VOLA_MEMENTO_API_KEY=
# Encryption at rest (docs/CRYPTO.md): the key file of the `tenant` provider — one base64 32-byte
# key per line, the FIRST line active, older lines kept for the files they wrapped (rotate by
# prepending a line; `vola keys-status` says how many files still depend on each). Create it with
# `vola keys-generate` (mode 0600) and back it up: without it every tenant-encrypted file is noise.
# A missing file does not stop the server — encrypted uploads, downloads and info answer
# 503 encryption_unavailable until it is there (re-read on change, no restart). The CLI
# (`transfer`, `keys-status`) and the worker read the same variable.
VOLA_KEY_FILE=/run/secrets/vola.key
# Keyrings (PIN per principal, docs/CRYPTO.md § 8): the pepper file — the Argon2 secret of every
# PIN and recovery key, same format as the key file (one base64 32-byte line, the FIRST active,
# rotate by prepending; `vola pepper-status` says how many keyrings still depend on each line).
# Create it with `vola pepper-generate` (0600) and back it up WITH the key file: without it no
# keyring can be unlocked or recovered. Keyrings also need VOLA_REDIS_URL (the unlock tokens live
# there); without Redis, the pepper file or the key file every keyring route and keyring file
# answers 503 encryption_unavailable. The worker does not need the pepper file.
VOLA_PEPPER_FILE=/run/secrets/vola.pepper
# Seconds an unlock token lives without a request (5–86400); every request that carries it in
# X-Vola-Unlock starts the count again (GET /vola/keyrings/me/status does not). Default 150 —
# the server-side backstop; a client locks earlier (Notes: 120 s idle + 10 s countdown).
VOLA_UNLOCK_TTL_S=150
# Derivatives of ENCRYPTED files (docs/CRYPTO.md § 11): the largest encrypted file a thumbnail
# or an OCR pass is made of — the whole plaintext is decrypted into memory for the render (never
# onto disk), in the request that holds the key (keyring, caller) or in the worker (tenant). A
# larger file gets no derivative (/thumb is 404 no_thumbnail, the job is SKIPPED). 0 turns
# derivatives of encrypted files off. Default 25 MiB.
VOLA_ENC_INLINE_DERIVE_MAX_BYTES=26214400
# Real-time `subscribe` WebSocket (GET /vola/udc/subscribe): a ping every VOLA_WS_HEARTBEAT_MS
# (a client that missed the last one is cut off), and how many unwritten messages a slow client
# may pile up before it is disconnected with code 4008. With VOLA_REDIS_URL file events travel
# through Redis pub/sub (`vola:files:<tenant id>`) so every server and worker process sees
# them; without it they stay in-process.
VOLA_WS_HEARTBEAT_MS=30000
VOLA_WS_MAX_BUFFERED=1000
# pino level: fatal | error | warn | info | debug | trace | silent
VOLA_LOG_LEVEL=info

# --- The examples site (apps/examples, docs/EXAMPLES-SITE.md) ------------------------
# A built single-page app the server serves at / and /en/ with an index.html fallback for its
# routes (apps/examples/dist after `pnpm --filter @vola/examples build`; the image sets
# /app/ui). Empty: the API only.
VOLA_UI_DIR=
# Behind a reverse proxy: take the client address from X-Forwarded-For (the demo routes' rate
# limit per address, the logs). Default false.
VOLA_TRUST_PROXY=false
# The demo routes under /vola/examples (GET /examples/config, the write proxy
# /examples/write/*, POST /examples/regenerate/:fileId, the purge). true needs BOTH keys below;
# at start the server creates the demo tenant when missing and stores the keys with their
# scopes (`vola demo-keys` prints a fresh pair). VOLA_DEMO_API_KEY is READ-ONLY (files:read,
# folders:read) and is handed to every visitor; VOLA_DEMO_WRITE_KEY never leaves the server —
# the proxy replays a visitor's writes under it, within the limits below.
VOLA_EXAMPLES=false
VOLA_DEMO_API_KEY=
VOLA_DEMO_WRITE_KEY=
# The demo tenant (created when missing) and the one instance the site shows.
VOLA_DEMO_TENANT=demo
VOLA_DEMO_INSTANCE_TYPE=demo
VOLA_DEMO_INSTANCE_ID=00000000-0000-4000-8000-000000000001
# The largest upload through the demo routes (5 MiB), hours after which a visitor's uploads,
# keyrings and folders are purged, writes one address may make per ten minutes, and how
# often the purge runs (0: never — tests).
VOLA_DEMO_MAX_UPLOAD_BYTES=5242880
VOLA_DEMO_TTL_HOURS=24
VOLA_DEMO_RATE_LIMIT=60
VOLA_DEMO_PURGE_INTERVAL_MIN=15
# `vola demo-seed` (the compose `seeder`): where the server is, the pack, and the write key
# above. The image sets VOLA_DEMO_ASSETS=/app/demo-assets.
VOLA_URL=http://localhost:8300/vola
VOLA_DEMO_ASSETS=apps/examples/assets

# --- compose.yaml / docker-compose.yaml only --------------------------------------
POSTGRES_USER=vola
POSTGRES_PASSWORD=vola
POSTGRES_DB=vola
POSTGRES_PORT=5432
REDIS_PORT=6379
# Host port of the `vola` service in docker-compose.yaml.
VOLA_HOST_PORT=8300
# The directory with vola.key and vola.pepper, mounted read-only at /run/secrets/vola in the
# vola and vola-worker containers (an empty or missing directory is fine: encrypted files and
# keyrings then answer 503). Make the files with `vola keys-generate` / `vola pepper-generate`.
VOLA_SECRETS_DIR=./secrets
# The examples site's demo pack at every `up`: COMPOSE_PROFILES=demo (or `--profile demo`).
# COMPOSE_PROFILES=demo

# --- E2E (packages/e2e) --------------------------------------------------------------
# A running server to test against (e.g. http://localhost:8300/vola, the docker-compose
# stack). Empty: the suite starts the built server itself on a free port, with the examples
# on and apps/examples/dist at / when it is built. Against an external server the examples
# suite runs when VOLA_DEMO_API_KEY and VOLA_DEMO_WRITE_KEY (above) are that server's.
VOLA_E2E_URL=
