{
  "name": "jsvola",
  "private": true,
  "type": "module",
  "description": "JSVola \u2014 self-hosted, multi-tenant content-addressable file storage (monorepo: @vol-a/core, @vol-a/server, @vol-a/cli, @vol-a/client, @vol-a/react)",
  "license": "MIT",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "test:cov": "turbo run test:cov",
    "test:coverage": "turbo run test:cov",
    "test:e2e": "turbo run test:e2e",
    "typecheck": "turbo run typecheck",
    "lint": "biome check .",
    "format": "biome format --write .",
    "dev": "pnpm --filter @vol-a/server dev",
    "dev:worker": "pnpm --filter @vol-a/server dev:worker",
    "start:worker": "pnpm --filter @vol-a/server start:worker",
    "db:up": "docker compose up -d postgres redis",
    "db:generate": "pnpm --filter @vol-a/server db:generate",
    "db:migrate": "pnpm --filter @vol-a/server db:migrate",
    "db:migrate:test": "pnpm --filter @vol-a/server db:migrate:test",
    "vola": "pnpm --filter @vol-a/cli exec tsx --conditions=@vol-a/source src/main.ts",
    "check:links": "node tools/check-links.mjs",
    "pack:dry": "node tools/pack-dry-run.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@types/node": "^24",
    "@vitest/coverage-v8": "^5.0.5",
    "tsx": "^4.23.15",
    "turbo": "^2.11.10",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  },
  "version": "1.0.1"
}
